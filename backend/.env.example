# Django Backend Environment Configuration
# Copy this file to backend/.env for local development. Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# SQLite database filename inside backend/ (used when DB_ENGINE=sqlite3)
SQLITE_DB_NAME=db.sqlite3

# Optional PostgreSQL production configuration (used with config.settings.prod)
# DB_ENGINE=postgresql
# DB_NAME=pos_db
# DB_USER=pos_user
# DB_PASSWORD=replace-with-strong-db-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=require

# Production HTTPS / CSRF settings (used with config.settings.prod)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pos.example.com

# JWT lifetimes
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Comma-separated frontend origins allowed via CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Inventory rules
INVENTORY_ALLOW_NEGATIVE_STOCK=False
