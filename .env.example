# POS System — Root Environment Reference
# Copy backend/.env.example -> backend/.env and frontend/.env.example -> frontend/.env
# Never commit real secrets or local .env files.

# --- Backend (backend/.env) ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
SQLITE_DB_NAME=db.sqlite3
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_NAME=POS System
